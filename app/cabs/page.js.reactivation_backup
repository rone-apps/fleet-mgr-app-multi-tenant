                onChange={(e) => setFormData({ ...formData, model: e.target.value })}
                fullWidth
                size="small"
              />
            </Grid>

            <Grid item xs={2}>
              <TextField
                label="Year"
                type="number"
                value={formData.year || ""}
                onChange={(e) => setFormData({ ...formData, year: e.target.value })}
                fullWidth
                size="small"
              />
            </Grid>

            <Grid item xs={2}>
              <TextField
                label="Color"
                value={formData.color || ""}
                onChange={(e) => setFormData({ ...formData, color: e.target.value })}
                fullWidth
                size="small"
              />
            </Grid>

            <Grid item xs={6}>
              <TextField
                required
                label="Fleet Added Date"
                type="date"
                value={formData.fleetAddedDate || ""}
                onChange={(e) => setFormData({ ...formData, fleetAddedDate: e.target.value })}
                InputLabelProps={{ shrink: true }}
                fullWidth
                size="small"
                disabled={editMode}
                helperText="Date when cab was added to fleet (used as ownership start date)"
              />
            </Grid>

            <Grid item xs={12}>
              <TextField
                label="Notes"
                value={formData.notes || ""}
                onChange={(e) => setFormData({ ...formData, notes: e.target.value })}
                fullWidth
                size="small"
                multiline
                rows={2}
              />
            </Grid>
          </Grid>

          {!editMode && (
            <>
              <Divider sx={{ my: 3 }} />

              {/* SECTION 2: SHIFT CONFIGURATION */}
              <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", mb: 2 }}>
                <Typography variant="h6" sx={{ color: "primary.main" }}>
                  Shift Configuration
                </Typography>
                <FormControlLabel
                  control={
                    <Checkbox
                      checked={skipShifts || false}
                      onChange={(e) => setSkipShifts(e.target.checked)}
                    />
                  }
                  label="Skip shifts (add later)"
                />
              </Box>

              {skipShifts && (
                <Alert severity="warning" sx={{ mb: 2 }}>
                  <Typography variant="body2" fontWeight="bold" gutterBottom>
                    ⚠️ Warning: Creating Cab Without Shifts
                  </Typography>
                  <Typography variant="body2">
                    This cab will be created in an incomplete state. You will need to manually add shifts later.
                    <strong> Without shifts, this cab cannot generate revenue or be assigned to drivers.</strong>
                  </Typography>
                </Alert>
              )}

              {!skipShifts && formData.shifts && (
                <>
                  <FormControl fullWidth size="small" sx={{ mb: 3 }}>
                    <InputLabel>Number of Shifts</InputLabel>
                    <Select
                      value={formData.cabShiftType || "DOUBLE"}
                      label="Number of Shifts"
                      onChange={(e) => handleShiftTypeChange(e.target.value)}
                    >
                      <MenuItem value="SINGLE">Single Shift (DAY only)</MenuItem>
                      <MenuItem value="DOUBLE">Double Shift (DAY + NIGHT)</MenuItem>
                    </Select>
                  </FormControl>

                  {/* Shift Cards */}
                  {formData.shifts.map((shift, index) => (
                    <Card
                      key={index}
                      variant="outlined"
                      sx={{
                        mb: 2,
                        border: 2,
                        borderColor: shift.shiftType === 'DAY' ? 'warning.light' : 'primary.light',
                        bgcolor: shift.shiftType === 'DAY' ? 'rgba(255, 152, 0, 0.08)' : 'rgba(25, 118, 210, 0.08)'
                      }}
                    >
                      <CardContent>
                        <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
                          <Box
                            sx={{
                              width: 40,
                              height: 40,
                              borderRadius: "50%",
                              bgcolor: shift.shiftType === 'DAY' ? 'warning.main' : 'primary.main',
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              fontSize: "1.5rem",
                              mr: 2
                            }}
                          >
                            {shift.shiftType === 'DAY' ? '☀️' : '🌙'}
                          </Box>
                          <Box>
                            <Typography variant="h6">
                              {shift.shiftType} Shift
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {shift.startTime} - {shift.endTime}
                            </Typography>
                          </Box>
                        </Box>

                        <Grid container spacing={2}>
                          {/* Owner */}
                          <Grid item xs={12}>
                            <Autocomplete
                              options={drivers.filter(d => d.isOwner)}
                              getOptionLabel={(option) =>
                                `${option.driverNumber} - ${option.firstName} ${option.lastName}`
                              }
                              value={drivers.find(d => d.id === shift.ownerId) || null}
                              onChange={(e, newValue) => handleShiftUpdate(index, {
                                ...shift,
                                ownerId: newValue?.id || null
                              })}
                              renderInput={(params) => (
                                <TextField
                                  {...params}
                                  label="Shift Owner *"
                                  size="small"
                                  required
                                  error={!shift.ownerId}
                                  helperText={!shift.ownerId ? "Owner is required" : ""}
                                />
                              )}
                            />
                          </Grid>

                          {/* Profile */}
                          <Grid item xs={12}>
                            <Autocomplete
                              options={shiftProfiles}
                              getOptionLabel={(option) =>
                                `${option.profileName}${option.isDefault ? ' (Default)' : ''}`
                              }
                              value={shiftProfiles.find(p => p.id === shift.profileId) || null}
                              onChange={(e, newValue) => handleShiftUpdate(index, {
                                ...shift,
                                profileId: newValue?.id || null
                              })}
                              renderInput={(params) => (
                                <TextField
                                  {...params}
                                  label="Shift Profile"
                                  size="small"
                                  helperText="Optional - default profile will be auto-assigned if not selected"
                                />
                              )}
                            />
                          </Grid>

                          {/* Cab Type */}
                          <Grid item xs={6}>
                            <FormControl fullWidth size="small">
                              <InputLabel>Cab Type *</InputLabel>
                              <Select
                                value={shift.cabType || "SEDAN"}
                                label="Cab Type *"
                                onChange={(e) => handleShiftUpdate(index, {
                                  ...shift,
                                  cabType: e.target.value
                                })}
                                required
                              >
                                <MenuItem value="SEDAN">Sedan</MenuItem>
                                <MenuItem value="HANDICAP_VAN">Handicap Van</MenuItem>
                              </Select>
                            </FormControl>
                          </Grid>

                          {/* Share Type */}
                          <Grid item xs={6}>
                            <FormControl fullWidth size="small">
                              <InputLabel>Share Type</InputLabel>
                              <Select
                                value={shift.shareType || ""}
                                label="Share Type"
                                onChange={(e) => handleShiftUpdate(index, {
                                  ...shift,
                                  shareType: e.target.value
                                })}
                              >
                                <MenuItem value="">None</MenuItem>
                                <MenuItem value="VOTING_SHARE">Voting Share</MenuItem>
                                <MenuItem value="NON_VOTING_SHARE">Non-Voting Share</MenuItem>
                              </Select>
                            </FormControl>
                          </Grid>

                          {/* Airport License */}
                          <Grid item xs={12}>
                            <FormControlLabel
                              control={
                                <Checkbox
                                  checked={shift.hasAirportLicense || false}
                                  onChange={(e) => handleShiftUpdate(index, {
                                    ...shift,
                                    hasAirportLicense: e.target.checked
                                  })}
                                />
                              }
                              label="Has Airport License"
                            />
                          </Grid>

                          {shift.hasAirportLicense && (
                            <>
                              <Grid item xs={6}>
                                <TextField
                                  label="License Number"
                                  value={shift.airportLicenseNumber || ""}
                                  onChange={(e) => handleShiftUpdate(index, {
                                    ...shift,
                                    airportLicenseNumber: e.target.value
                                  })}
                                  fullWidth
                                  size="small"
                                />
                              </Grid>
                              <Grid item xs={6}>
                                <TextField
                                  label="License Expiry"
                                  type="date"
                                  value={shift.airportLicenseExpiry || ""}
                                  onChange={(e) => handleShiftUpdate(index, {
                                    ...shift,
                                    airportLicenseExpiry: e.target.value
                                  })}
                                  InputLabelProps={{ shrink: true }}
                                  fullWidth
                                  size="small"
                                />
                              </Grid>
                            </>
                          )}
                        </Grid>
                      </CardContent>
                    </Card>
                  ))}

                  {/* Bulk Assign */}
                  {formData.shifts.length > 1 && (
                    <Box sx={{ mt: 2, p: 2, bgcolor: 'info.light', borderRadius: 1 }}>
                      <Typography variant="body2" gutterBottom fontWeight="bold">
                        💡 Quick Assign: Same owner for all shifts?
                      </Typography>
                      <Autocomplete
                        options={drivers.filter(d => d.isOwner)}
                        getOptionLabel={(option) =>
                          `${option.driverNumber} - ${option.firstName} ${option.lastName}`
                        }
                        onChange={(e, driver) => {
                          if (driver) {
                            setFormData(prev => ({
                              ...prev,
                              shifts: prev.shifts.map(shift => ({
                                ...shift,
                                ownerId: driver.id
                              }))
                            }));
                          }
                        }}
                        renderInput={(params) => (
                          <TextField
                            {...params}
                            label="Assign to all shifts"
                            size="small"
                          />
                        )}
                      />
                    </Box>
                  )}
                </>
              )}
            </>
          )}
        </DialogContent>

        <DialogActions>
          <Button onClick={handleCloseDialog}>
            Cancel
          </Button>
          <Button
            onClick={handleSubmit}
            variant="contained"
            startIcon={<AddIcon />}
          >
            {editMode ? "Update Cab" : (skipShifts ? "Create Cab Only" : "Create Cab with Shifts")}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Assign/Edit Attribute Dialog */}
      <Dialog open={openAttributeDialog} onClose={handleCloseAttributeDialog} maxWidth="sm" fullWidth>
        <DialogTitle>
          {editingAttribute ? "Edit Attribute" : "Assign Attribute"}
        </DialogTitle>
        <DialogContent dividers>
          {error && (
            <Alert severity="error" sx={{ mb: 2 }}>
              {error}
            </Alert>
          )}

          <TextField
            select
            fullWidth
            margin="normal"
            label="Attribute Type"
            name="attributeTypeId"
            value={attributeFormData.attributeTypeId}
            onChange={handleAttributeFormChange}
            disabled={editingAttribute}
            helperText={editingAttribute ? "Type cannot be changed" : ""}
          >
            {attributeTypes.map((type) => (
              <MenuItem key={type.id} value={type.id}>
                {type.attributeName}
              </MenuItem>
            ))}
          </TextField>

          {attributeFormData.attributeTypeId &&
            getAttributeType(parseInt(attributeFormData.attributeTypeId))?.requiresValue && (
            <TextField
              fullWidth
              margin="normal"
              label="Value"
              name="attributeValue"
              value={attributeFormData.attributeValue}
              onChange={handleAttributeFormChange}
              placeholder="e.g., License Number or ID"
            />
          )}

          <TextField
            fullWidth
            margin="normal"
            label="Start Date"
            name="startDate"
            type="date"
            value={attributeFormData.startDate}
            onChange={handleAttributeFormChange}
            InputLabelProps={{ shrink: true }}
          />

          <TextField
            fullWidth
            margin="normal"
            label="End Date (Optional)"
            name="endDate"
            type="date"
            value={attributeFormData.endDate}
            onChange={handleAttributeFormChange}
            InputLabelProps={{ shrink: true }}
            helperText="Leave blank for ongoing"
          />

          <TextField
            fullWidth
            margin="normal"
            label="Notes"
            name="notes"
            value={attributeFormData.notes}
            onChange={handleAttributeFormChange}
            multiline
            rows={2}
            placeholder="Optional notes"
          />
        </DialogContent>
        <DialogActions>
          <Button onClick={handleCloseAttributeDialog}>Cancel</Button>
          <Button onClick={handleSubmitAttribute} variant="contained" color="primary">
            {editingAttribute ? "Update" : "Assign"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Create/Edit Attribute Type Dialog */}
      <Dialog open={openAttributeTypeDialog} onClose={() => setOpenAttributeTypeDialog(false)} maxWidth="sm" fullWidth>
        <DialogTitle>
          {attributeTypeDialogMode === "create"
            ? "Create Attribute Type"
            : `Edit: ${editingAttributeType?.attributeName}`}
        </DialogTitle>
        <DialogContent dividers>
          {error && (
            <Alert severity="error" sx={{ mb: 2 }}>
              {error}
            </Alert>
          )}

          <TextField
            fullWidth
            margin="normal"
            label="Attribute Code"
            value={attributeTypeFormData.attributeCode}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, attributeCode: e.target.value })}
            disabled={attributeTypeDialogMode === "edit"}
            placeholder="e.g., AIRPORT_LICENSE"
            helperText={
              attributeTypeDialogMode === "edit" ? "Code cannot be changed" : "Unique identifier"
            }
          />

          <TextField
            fullWidth
            margin="normal"
            label="Attribute Name"
            value={attributeTypeFormData.attributeName}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, attributeName: e.target.value })}
            placeholder="e.g., Airport License"
          />

          <TextField
            fullWidth
            margin="normal"
            label="Description"
            value={attributeTypeFormData.description}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, description: e.target.value })}
            multiline
            rows={2}
          />

          <TextField
            select
            fullWidth
            margin="normal"
            label="Category"
            value={attributeTypeFormData.category}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, category: e.target.value })}
          >
            <MenuItem value="LICENSE">License/Permit</MenuItem>
            <MenuItem value="EQUIPMENT">Equipment/Hardware</MenuItem>
            <MenuItem value="TYPE">Vehicle Type/Classification</MenuItem>
            <MenuItem value="PERMIT">Special Permits</MenuItem>
            <MenuItem value="CERTIFICATION">Certifications</MenuItem>
          </TextField>

          <TextField
            select
            fullWidth
            margin="normal"
            label="Data Type"
            value={attributeTypeFormData.dataType}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, dataType: e.target.value })}
          >
            <MenuItem value="STRING">Text</MenuItem>
            <MenuItem value="NUMBER">Number</MenuItem>
            <MenuItem value="DATE">Date</MenuItem>
            <MenuItem value="BOOLEAN">Yes/No</MenuItem>
          </TextField>

          <FormControlLabel
            control={
              <Checkbox
                checked={attributeTypeFormData.requiresValue}
                onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, requiresValue: e.target.checked })}
              />
            }
            label="Requires Value (e.g., License Number)"
            sx={{ my: 1 }}
          />

          <TextField
            fullWidth
            margin="normal"
            label="Validation Pattern (Regex)"
            value={attributeTypeFormData.validationPattern}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, validationPattern: e.target.value })}
            placeholder="Optional regex for validation"
            helperText="Leave empty for no validation"
          />

          <TextField
            fullWidth
            margin="normal"
            label="Help Text"
            value={attributeTypeFormData.helpText}
            onChange={(e) => setAttributeTypeFormData({ ...attributeTypeFormData, helpText: e.target.value })}
            multiline
            rows={2}
            placeholder="Guide text for users"
          />
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpenAttributeTypeDialog(false)}>Cancel</Button>
          <Button onClick={handleSubmitAttributeType} variant="contained" color="primary">
            {attributeTypeDialogMode === "create" ? "Create" : "Update"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Deactivation Dialog */}
      <Dialog
        open={openDeactivateDialog}
        onClose={() => setOpenDeactivateDialog(false)}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>
          <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <Typography variant="h6">Remove Cab from Fleet</Typography>
            <IconButton onClick={() => setOpenDeactivateDialog(false)}>
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>

        <DialogContent dividers>
          {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}

          <Alert severity="warning" sx={{ mb: 3 }}>
            <Typography variant="body2" gutterBottom fontWeight="bold">
              Warning: This will deactivate the cab and all its shifts
            </Typography>
            <ul style={{ margin: "4px 0 0 0", paddingLeft: 20 }}>
              <li>Cab will be marked as INACTIVE</li>
              <li>All shifts for this cab will be deactivated</li>
              <li>Active shift ownership records will be ended</li>
            </ul>
            <Typography variant="body2" sx={{ mt: 1, fontStyle: "italic" }}>
              Historical reports will still include this cab for periods before removal.
            </Typography>
          </Alert>

          {selectedCabForDeactivation && (
            <Box sx={{ mb: 3, p: 2, bgcolor: "#f5f5f5", borderRadius: 1 }}>
              <Typography variant="subtitle2" gutterBottom fontWeight="bold">
                Cab Details
              </Typography>
              <Grid container spacing={1}>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Cab Number</Typography>
                  <Typography variant="body2">{selectedCabForDeactivation.cabNumber}</Typography>
                </Grid>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Registration</Typography>
                  <Typography variant="body2">{selectedCabForDeactivation.registrationNumber}</Typography>
                </Grid>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Make/Model</Typography>
                  <Typography variant="body2">
                    {selectedCabForDeactivation.make} {selectedCabForDeactivation.model}
                  </Typography>
                </Grid>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Fleet Added</Typography>
                  <Typography variant="body2">
                    {selectedCabForDeactivation.fleetAddedDate
                      ? new Date(selectedCabForDeactivation.fleetAddedDate).toLocaleDateString()
                      : "N/A"
                    }
                  </Typography>
                </Grid>
              </Grid>
            </Box>
          )}

          <TextField
            label="Deactivation Date"
            type="date"
            value={deactivateFormData.deactivationDate}
            onChange={(e) => setDeactivateFormData({
              ...deactivateFormData,
              deactivationDate: e.target.value
            })}
            fullWidth
            required
            size="small"
            InputLabelProps={{ shrink: true }}
            helperText="Date when cab was physically removed from fleet (can be backdated)"
            sx={{ mb: 2 }}
            inputProps={{
              max: new Date().toISOString().split('T')[0], // Cannot be in future
              min: selectedCabForDeactivation?.fleetAddedDate, // Cannot be before added
            }}
          />

          <TextField
            label="Reason for Removal"
            value={deactivateFormData.reason}
            onChange={(e) => setDeactivateFormData({
              ...deactivateFormData,
              reason: e.target.value
            })}
            fullWidth
            multiline
            rows={3}
            size="small"
            placeholder="e.g., Sold, Scrapped, Damaged, End of lease..."
            helperText="Optional: Explain why the cab is being removed from service"
          />
        </DialogContent>

        <DialogActions>
          <Button onClick={() => setOpenDeactivateDialog(false)}>
            Cancel
          </Button>
          <Button
            onClick={handleDeactivateCab}
            variant="contained"
            color="error"
            startIcon={<BlockIcon />}
          >
            Remove from Fleet
          </Button>
        </DialogActions>
      </Dialog>

      {/* Reactivation Dialog */}
      <Dialog
        open={openReactivateDialog}
        onClose={() => setOpenReactivateDialog(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>
          <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <Typography variant="h6">Reactivate Cab</Typography>
            <IconButton onClick={() => setOpenReactivateDialog(false)}>
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>

        <DialogContent dividers>
          {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}

          <Alert severity="info" sx={{ mb: 3 }}>
            <Typography variant="body2" gutterBottom fontWeight="bold">
              Bringing cab back into service
            </Typography>
            <ul style={{ margin: "4px 0 0 0", paddingLeft: 20 }}>
              <li>Cab will be marked as ACTIVE</li>
              <li>All shifts will be reactivated with new status history</li>
              <li>New ownership records will be created for each shift</li>
              <li>You must assign an owner for each shift</li>
            </ul>
          </Alert>

          {selectedCabForReactivation && (
            <Box sx={{ mb: 3, p: 2, bgcolor: "#f5f5f5", borderRadius: 1 }}>
              <Typography variant="subtitle2" gutterBottom fontWeight="bold">
                Cab Details
              </Typography>
              <Grid container spacing={1}>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Cab Number</Typography>
                  <Typography variant="body2">{selectedCabForReactivation.cabNumber}</Typography>
                </Grid>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Registration</Typography>
                  <Typography variant="body2">{selectedCabForReactivation.registrationNumber}</Typography>
                </Grid>
                <Grid item xs={6}>
                  <Typography variant="caption" color="textSecondary">Deactivated On</Typography>
                  <Typography variant="body2">
                    {selectedCabForReactivation.deactivatedDate
                      ? new Date(selectedCabForReactivation.deactivatedDate).toLocaleDateString()
                      : "N/A"
                    }
                  </Typography>
                </Grid>
              </Grid>
            </Box>
          )}

          <TextField
            label="Reactivation Start Date"
            type="date"
            value={reactivateFormData.reactivationDate}
            onChange={(e) => setReactivateFormData({
              ...reactivateFormData,
              reactivationDate: e.target.value
            })}
            fullWidth
            required
            size="small"
            InputLabelProps={{ shrink: true }}
            helperText="First day cab will be active again (ownership starts from this date)"
            sx={{ mb: 2 }}
            inputProps={{
              min: selectedCabForReactivation?.deactivatedDate, // Cannot be before deactivation
            }}
          />

          <TextField
            label="Reason for Reactivation"
            value={reactivateFormData.reason}
            onChange={(e) => setReactivateFormData({
              ...reactivateFormData,
              reason: e.target.value
            })}
            fullWidth
            multiline
            rows={2}
            size="small"
            placeholder="e.g., Repairs completed, Lease renewed, Repurchased..."
            helperText="Optional: Explain why cab is being reactivated"
            sx={{ mb: 3 }}
          />

          <Typography variant="subtitle2" fontWeight="bold" sx={{ mb: 2 }}>
            Assign Owners for Each Shift
          </Typography>

          {shiftsForReactivation.map(shift => {
            const owners = drivers.filter(d => d.isOwner);
            const selectedOwner = owners.find(d => d.id === reactivateFormData.shiftOwnerAssignments[shift.id]);

            return (
              <Autocomplete
                key={shift.id}
                options={owners}
                getOptionLabel={(option) => `${option.driverNumber} - ${option.firstName} ${option.lastName}`}
                value={selectedOwner || null}
                onChange={(event, newValue) => {
                  setReactivateFormData({
                    ...reactivateFormData,
                    shiftOwnerAssignments: {
                      ...reactivateFormData.shiftOwnerAssignments,
                      [shift.id]: newValue?.id || null
                    }
                  });
                }}
                renderInput={(params) => (
                  <TextField
                    {...params}
                    label={`${shift.shiftType} Shift Owner *`}
                    size="small"
                    required
                    error={!reactivateFormData.shiftOwnerAssignments[shift.id]}
                    helperText={!reactivateFormData.shiftOwnerAssignments[shift.id] ? 'Owner required' : ''}
                  />
                )}
                sx={{ mb: 2 }}
              />
            );
          })}
        </DialogContent>

        <DialogActions>
          <Button onClick={() => setOpenReactivateDialog(false)}>
            Cancel
          </Button>
          <Button
            onClick={handleReactivateCab}
            variant="contained"
            color="success"
          >
            Reactivate Cab
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}