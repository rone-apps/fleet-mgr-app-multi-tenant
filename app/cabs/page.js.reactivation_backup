                        <Typography variant="body2" color="textSecondary">-</Typography>
                      )}
                    </TableCell>
                    <TableCell>
                      {cab.shareType ? (
                        <Chip
                          label={cab.shareType === "VOTING_SHARE" ? "Voting" : "Non-Voting"}
                          color={cab.shareType === "VOTING_SHARE" ? "primary" : "default"}
                          size="small"
                          variant="outlined"
                        />
                      ) : (
                        <Typography variant="body2" color="textSecondary">-</Typography>
