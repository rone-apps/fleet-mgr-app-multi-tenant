"use client";

import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import GlobalNav from "../components/GlobalNav";
import {
  Box,
  Typography,
  Button,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  Chip,
  TextField,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  IconButton,
  MenuItem,
  Select,
  FormControl,
  InputLabel,
  Alert,
  Tooltip,
  Checkbox,
  FormControlLabel,
  Card,
  CardContent,
  Grid,
  Tabs,
  Tab,
  Divider,
  Autocomplete,
  Container,
  InputAdornment,
  Menu,
} from "@mui/material";
import {
  Add as AddIcon,
  Edit as EditIcon,
  DirectionsCar,
  Close as CloseIcon,
  Build as BuildIcon,
  CheckCircle as CheckCircleIcon,
  Block as BlockIcon,
  AirplanemodeActive as AirportIcon,
  Delete as DeleteIcon,
  History as HistoryIcon,
  Tune as TuneIcon,
  Search as SearchIcon,
  FilterList as FilterListIcon,
  Clear as ClearIcon,
  Download as DownloadIcon,
} from "@mui/icons-material";
import { getCurrentUser, API_BASE_URL } from "../lib/api";
import { downloadCSV, downloadPDF, formatCabsForExport } from "../lib/exportUtils";

export default function CabsPage() {
  const router = useRouter();
  const [currentUser, setCurrentUser] = useState(null);
  const [cabs, setCabs] = useState([]);
  const [drivers, setDrivers] = useState([]);
  const [filteredCabs, setFilteredCabs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  // Tab state
  const [activeTab, setActiveTab] = useState(0);

  // Dialog states
  const [openDialog, setOpenDialog] = useState(false);
  const [editMode, setEditMode] = useState(false);
  const [selectedCab, setSelectedCab] = useState(null);

  // Download menu state
  const [downloadMenuAnchor, setDownloadMenuAnchor] = useState(null);

  // Deactivation dialog states
  const [openDeactivateDialog, setOpenDeactivateDialog] = useState(false);
  const [selectedCabForDeactivation, setSelectedCabForDeactivation] = useState(null);
  const [deactivateFormData, setDeactivateFormData] = useState({
    deactivationDate: new Date().toISOString().split('T')[0],
    reason: "",
  });

  // Reactivation states
  const [openReactivateDialog, setOpenReactivateDialog] = useState(false);
  const [selectedCabForReactivation, setSelectedCabForReactivation] = useState(null);
  const [reactivateFormData, setReactivateFormData] = useState({
    reactivationDate: new Date().toISOString().split('T')[0],
    reason: "",
    keepSameOwners: true, // Default to quick reactivation
    shiftOwnerAssignments: {}, // { shiftId: ownerId } - for same owners mode
    shifts: [] // For new owners mode - full shift configuration
  });
  const [shiftsForReactivation, setShiftsForReactivation] = useState([]);

  // Attribute states
  const [attributeTypes, setAttributeTypes] = useState([]);
  const [currentAttributes, setCurrentAttributes] = useState([]);
  const [attributeHistory, setAttributeHistory] = useState([]);
  const [selectedCabForAttributes, setSelectedCabForAttributes] = useState(null);
  const [showAttributeHistory, setShowAttributeHistory] = useState(false);
  const [openAttributeDialog, setOpenAttributeDialog] = useState(false);
  const [editingAttribute, setEditingAttribute] = useState(null);
  const [cabAttributesMap, setCabAttributesMap] = useState({}); // Map of cabId -> attributes array

  // Filter states
  const [searchTerm, setSearchTerm] = useState("");
  const [statusFilter, setStatusFilter] = useState("ALL");
  const [typeFilter, setTypeFilter] = useState("ALL");
  const [airportFilter, setAirportFilter] = useState("ALL");
  const [shareTypeFilter, setShareTypeFilter] = useState("ALL");
  const [shiftTypeFilter, setShiftTypeFilter] = useState("ALL");

  // Form data with shift configuration
  const [formData, setFormData] = useState({
    cabNumber: "",
    registrationNumber: "N/A",
    make: "",
    model: "",
    year: "",
    color: "",
    fleetAddedDate: new Date().toISOString().split('T')[0],
    notes: "",
    cabShiftType: "DOUBLE",
    shifts: [
      {
        shiftType: "DAY",
        ownerId: null,
        profileId: null,
        cabType: "SEDAN",
        shareType: "VOTING_SHARE",
        hasAirportLicense: false,
        airportLicenseNumber: "",
        airportLicenseExpiry: "",
        startTime: "06:00",
        endTime: "18:00",
        notes: ""
      },
      {
        shiftType: "NIGHT",
        ownerId: null,
        profileId: null,
        cabType: "SEDAN",
        shareType: "VOTING_SHARE",
        hasAirportLicense: false,
        airportLicenseNumber: "",
        airportLicenseExpiry: "",
        startTime: "18:00",
        endTime: "06:00",
        notes: ""
      }
    ]
  });

  const [skipShifts, setSkipShifts] = useState(false);
  const [shiftProfiles, setShiftProfiles] = useState([]);

  // Attribute form data
  const [attributeFormData, setAttributeFormData] = useState({
    attributeTypeId: "",
    attributeValue: "",
    startDate: "",
    endDate: "",
    notes: "",
  });

  // Attribute Types Management States
  const [allAttributeTypes, setAllAttributeTypes] = useState([]);
  const [filteredAttributeTypes, setFilteredAttributeTypes] = useState([]);
  const [attributeTypeSearchTerm, setAttributeTypeSearchTerm] = useState("");
  const [attributeTypeCategoryFilter, setAttributeTypeCategoryFilter] = useState("ALL");
  const [attributeTypeStatusFilter, setAttributeTypeStatusFilter] = useState("ALL");
  const [openAttributeTypeDialog, setOpenAttributeTypeDialog] = useState(false);
  const [attributeTypeDialogMode, setAttributeTypeDialogMode] = useState("create");
  const [editingAttributeType, setEditingAttributeType] = useState(null);
  const [attributeTypeFormData, setAttributeTypeFormData] = useState({
    attributeCode: "",
    attributeName: "",
    description: "",
    category: "LICENSE",
    dataType: "STRING",
    requiresValue: false,
    validationPattern: "",
    helpText: "",
  });

  // Check authentication and load cabs
  useEffect(() => {
    const token = localStorage.getItem("token");
    if (!token) {
      router.push("/signin");
      return;
    }

    const user = getCurrentUser();
    setCurrentUser(user);

    // Check if user has access
    if (!["ADMIN", "MANAGER", "DISPATCHER"].includes(user?.role)) {
      router.push("/");
      return;
    }

    loadCabs();
    loadDrivers();
    loadAttributeTypes();
    loadShiftProfiles();
  }, [router]);

  // Filter cabs whenever search/filter changes
  useEffect(() => {
    filterCabs();
  }, [searchTerm, statusFilter, typeFilter, airportFilter, shareTypeFilter, shiftTypeFilter, cabs]);

  const loadCabs = async () => {
    try {
      // Always load ALL cabs (including inactive) for cabs management page
      const response = await fetch(`${API_BASE_URL}/cabs?includeInactive=true`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });

      if (response.ok) {
        const data = await response.json();
        console.log("🚗 Cabs loaded:", data);

        // ✅ Sort by cab number (numeric)
        const sortedCabs = data.sort((a, b) => {
          // Extract numeric part from cab number (e.g., "CAB-001" -> 1, "CAB-123" -> 123)
          const numA = parseInt(a.cabNumber?.replace(/\D/g, '') || '0');
          const numB = parseInt(b.cabNumber?.replace(/\D/g, '') || '0');
          return numA - numB;
        });

        setCabs(sortedCabs);

        // Load current attributes for all cabs
        loadCabsAttributes(sortedCabs);
      } else {
        setError("Failed to load cabs");
      }
      setLoading(false);
    } catch (err) {
      console.error("Error loading cabs:", err);
      setError("Failed to load cabs");
      setLoading(false);
    }
  };

  const loadDrivers = async () => {
    try {
      const response = await fetch(`${API_BASE_URL}/drivers`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });

      if (response.ok) {
        const data = await response.json();
        setDrivers(data);
      }
    } catch (err) {
      console.error("Error loading drivers:", err);
    }
  };

  const loadShiftProfiles = async () => {
    try {
      const response = await fetch(`${API_BASE_URL}/shift-profiles`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });

      if (response.ok) {
        const data = await response.json();
        setShiftProfiles(data.filter(p => p.isActive));
      }
    } catch (err) {
      console.error("Error loading shift profiles:", err);
    }
  };

  const loadCabsAttributes = async (cabsList) => {
    try {
      const attributesMap = {};

      // Load attributes for each cab in parallel
      const attributePromises = cabsList.map((cab) =>
        fetch(`${API_BASE_URL}/cabs/${cab.id}/attributes/current`, {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
            "X-Tenant-ID": localStorage.getItem("tenantSchema"),
          },
        })
          .then((res) => (res.ok ? res.json() : []))
          .then((attrs) => {
            console.log(`Attributes for cab ${cab.id}:`, attrs);
            attributesMap[cab.id] = attrs;
          })
          .catch((err) => {
            console.error(`Error loading attributes for cab ${cab.id}:`, err);
            attributesMap[cab.id] = [];
          })
      );

      await Promise.all(attributePromises);
      setCabAttributesMap(attributesMap);
    } catch (err) {
      console.error("Error loading cab attributes:", err);
    }
  };

  const filterCabs = () => {
    let filtered = [...cabs];

    // Search by cab number, registration, make, model
    if (searchTerm) {
      const term = searchTerm.toLowerCase();
      filtered = filtered.filter(
        (cab) =>
          cab.cabNumber?.toLowerCase().includes(term) ||
          cab.registrationNumber?.toLowerCase().includes(term) ||
          cab.make?.toLowerCase().includes(term) ||
          cab.model?.toLowerCase().includes(term)
      );
    }

    // Filter by status
    if (statusFilter !== "ALL") {
      filtered = filtered.filter((cab) => cab.status === statusFilter);
    }

    // Filter by type
    if (typeFilter !== "ALL") {
      filtered = filtered.filter((cab) => cab.cabType === typeFilter);
    }

    // Filter by airport license
    if (airportFilter === "LICENSED") {
      filtered = filtered.filter((cab) => cab.hasAirportLicense);
    } else if (airportFilter === "UNLICENSED") {
      filtered = filtered.filter((cab) => !cab.hasAirportLicense);
    }

    // Filter by share type
    if (shareTypeFilter !== "ALL") {
      filtered = filtered.filter((cab) => cab.shareType === shareTypeFilter);
    }

    // Filter by shift type
    if (shiftTypeFilter !== "ALL") {
      filtered = filtered.filter((cab) => cab.cabShiftType === shiftTypeFilter);
    }

    setFilteredCabs(filtered);
  };

  const handleOpenDialog = (cab = null) => {
    if (cab) {
      // Edit mode
      setEditMode(true);
      setSelectedCab(cab);
      setFormData({
        cabNumber: cab.cabNumber || "",
        registrationNumber: cab.registrationNumber || "",
        make: cab.make || "",
        model: cab.model || "",
        year: cab.year || "",
        color: cab.color || "",
        cabType: cab.cabType || "SEDAN",
        shareType: cab.shareType || "",
        cabShiftType: cab.cabShiftType || "",
        hasAirportLicense: cab.hasAirportLicense || false,
        airportLicenseNumber: cab.airportLicenseNumber || "",
        airportLicenseExpiry: cab.airportLicenseExpiry || "",
        notes: cab.notes || "",
      });
    } else {
      // Create mode
      setEditMode(false);
      setSelectedCab(null);
      setFormData({
        cabNumber: "",
        registrationNumber: "N/A",
        make: "",
        model: "",
        year: "",
        color: "",
        fleetAddedDate: new Date().toISOString().split('T')[0],
        notes: "",
        cabShiftType: "DOUBLE",
        shifts: [
          {
            shiftType: "DAY",
            ownerId: null,
            profileId: null,
            cabType: "SEDAN",
            shareType: "VOTING_SHARE",
            hasAirportLicense: false,
            airportLicenseNumber: "",
            airportLicenseExpiry: "",
            startTime: "06:00",
            endTime: "18:00",
            notes: ""
          },
          {
            shiftType: "NIGHT",
            ownerId: null,
            profileId: null,
            cabType: "SEDAN",
            shareType: "VOTING_SHARE",
            hasAirportLicense: false,
            airportLicenseNumber: "",
            airportLicenseExpiry: "",
            startTime: "18:00",
            endTime: "06:00",
            notes: ""
          }
        ]
      });
      setSkipShifts(false);
    }

    setError("");
    setSuccess("");
    setOpenDialog(true);
  };

  const handleCloseDialog = () => {
    setOpenDialog(false);
    setSelectedCab(null);
    setFormData({
      cabNumber: "",
      registrationNumber: "N/A",
      make: "",
      model: "",
      year: "",
      color: "",
      cabType: "SEDAN",
      shareType: "",
      cabShiftType: "",
      hasAirportLicense: false,
      airportLicenseNumber: "",
      airportLicenseExpiry: "",
      notes: "",
    });
  };

  const handleShiftTypeChange = (newShiftType) => {
    setFormData(prev => {
      const shifts = newShiftType === "SINGLE"
        ? [prev.shifts[0]]
        : prev.shifts.length === 1
          ? [
              ...prev.shifts,
              {
                shiftType: "NIGHT",
                ownerId: null,
                profileId: null,
                cabType: prev.shifts[0].cabType,
                shareType: prev.shifts[0].shareType,
                hasAirportLicense: prev.shifts[0].hasAirportLicense,
                airportLicenseNumber: "",
                airportLicenseExpiry: "",
                startTime: "18:00",
                endTime: "06:00",
                notes: ""
              }
            ]
          : prev.shifts;

      return { ...prev, cabShiftType: newShiftType, shifts };
    });
  };

  const handleShiftUpdate = (index, updatedShift) => {
    setFormData(prev => ({
      ...prev,
      shifts: prev.shifts.map((shift, i) => i === index ? updatedShift : shift)
    }));
  };

  const handleSubmit = async () => {
    // Edit mode uses old format
    if (editMode) {
      try {
        const response = await fetch(`${API_BASE_URL}/cabs/${selectedCab.id}`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${localStorage.getItem("token")}`,
            "X-Tenant-ID": localStorage.getItem("tenantSchema"),
          },
          body: JSON.stringify(formData),
        });

        if (response.ok) {
          const data = await response.json();
          setSuccess(data.message || "Cab updated successfully");
          handleCloseDialog();
          loadCabs();
        } else {
          const errorData = await response.json();
          setError(errorData.error || "Failed to update cab");
        }
      } catch (err) {
        console.error("Error updating cab:", err);
        setError("Failed to update cab");
      }
      return;
    }

    // Create mode with shift validation
    if (!skipShifts) {
      const missingOwners = formData.shifts.filter(s => !s.ownerId);
      if (missingOwners.length > 0) {
        setError("Please assign an owner to all shifts, or check 'Skip shifts (add later)'");
        return;
      }
    }

    try {
      const payload = {
        cabNumber: formData.cabNumber || null,
        registrationNumber: formData.registrationNumber,
        make: formData.make,
        model: formData.model,
        year: formData.year ? parseInt(formData.year) : null,
        color: formData.color,
        fleetAddedDate: formData.fleetAddedDate,
        notes: formData.notes,
        cabShiftType: formData.cabShiftType,

        shifts: skipShifts ? [] : formData.shifts.map(shift => ({
          shiftType: shift.shiftType,
          ownerId: shift.ownerId,
          profileId: shift.profileId,
          cabType: shift.cabType,
          shareType: shift.shareType,
          hasAirportLicense: shift.hasAirportLicense,
          airportLicenseNumber: shift.airportLicenseNumber,
          airportLicenseExpiry: shift.airportLicenseExpiry,
          startTime: shift.startTime,
          endTime: shift.endTime,
          notes: shift.notes
        }))
      };

      const response = await fetch(`${API_BASE_URL}/cabs`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        const data = await response.json();
        setSuccess(
          `Cab ${data.cab.cabNumber} created successfully` +
          (skipShifts ? " (without shifts)" : ` with ${formData.shifts.length} shifts`)
        );
        handleCloseDialog();
        loadCabs();
      } else {
        const errorData = await response.json();
        setError(errorData.error || "Failed to create cab");
      }
    } catch (err) {
      console.error("Error creating cab:", err);
      setError("Failed to create cab");
    }
  };

  const handleStatusChange = async (cabId, action) => {
    try {
      const response = await fetch(`${API_BASE_URL}/cabs/${cabId}/${action}`, {
        method: "PUT",
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`, "X-Tenant-ID": localStorage.getItem("tenantSchema"),
            "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });

      if (response.ok) {
        const data = await response.json();
        setSuccess(data.message);
        loadCabs();
      } else {
        setError(`Failed to ${action} cab`);
      }
    } catch (err) {
      console.error(`Error changing cab status:`, err);
      setError(`Failed to ${action} cab`);
    }
  };

  const handleOpenDeactivateDialog = (cab) => {
    setSelectedCabForDeactivation(cab);
    setDeactivateFormData({
      deactivationDate: new Date().toISOString().split('T')[0],
      reason: "",
    });
    setError("");
    setOpenDeactivateDialog(true);
  };

  const handleDeactivateCab = async () => {
    if (!selectedCabForDeactivation) return;

    setError("");

    try {
      const response = await fetch(
        `${API_BASE_URL}/cabs/${selectedCabForDeactivation.id}/deactivate`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${localStorage.getItem("token")}`,
            "X-Tenant-ID": localStorage.getItem("tenantSchema"),
          },
          body: JSON.stringify({
            deactivationDate: deactivateFormData.deactivationDate,
            reason: deactivateFormData.reason,
            deactivatedBy: "admin", // TODO: Get from auth context
          }),
        }
      );

      if (response.ok) {
        const data = await response.json();
        setSuccess(`Cab ${selectedCabForDeactivation.cabNumber} deactivated successfully`);
        setOpenDeactivateDialog(false);
        setSelectedCabForDeactivation(null);

        // Force full page reload to refresh all cab and shift data
        window.location.reload();
      } else {
        const errorData = await response.json();
        setError(errorData.error || "Failed to deactivate cab");
      }
    } catch (err) {
      console.error("Error deactivating cab:", err);
      setError("Failed to deactivate cab");
    }
  };

  const handleOpenReactivateDialog = async (cab) => {
    setSelectedCabForReactivation(cab);
    setError("");

    // Load shifts for this cab
    try {
      const response = await fetch(`${API_BASE_URL}/shifts/cab/${cab.id}`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });

      if (response.ok) {
        const shifts = await response.json();
        setShiftsForReactivation(shifts);

        // Initialize for BOTH modes
        const initialAssignments = {};
        const initialShiftConfigs = [];

        shifts.forEach(shift => {
          // Mode 1: Same owners - keep current owner
          initialAssignments[shift.id] = shift.currentOwner?.id || null;

          // Mode 2: New owners - initialize full config
          initialShiftConfigs.push({
            shiftId: shift.id,
            shiftType: shift.shiftType,
            ownerId: shift.currentOwner?.id || null,
            profileId: shift.currentProfile?.id || null,
            cabType: shift.cabType || "SEDAN",
            shareType: shift.shareType || "VOTING_SHARE",
            hasAirportLicense: shift.hasAirportLicense || false,
            airportLicenseNumber: shift.airportLicenseNumber || "",
            airportLicenseExpiry: shift.airportLicenseExpiry || "",
            notes: ""
          });
        });

        setReactivateFormData({
          reactivationDate: new Date().toISOString().split('T')[0],
          reason: "",
          keepSameOwners: true, // Default to quick mode
          shiftOwnerAssignments: initialAssignments,
          shifts: initialShiftConfigs
        });

        setOpenReactivateDialog(true);
      } else {
        setError("Failed to load shifts for reactivation");
      }
    } catch (err) {
      console.error("Error loading shifts:", err);
      setError("Failed to load shifts for reactivation");
    }
  };

  const handleReactivateCab = async () => {
    if (!selectedCabForReactivation) return;

    // Validate based on mode
    if (reactivateFormData.keepSameOwners) {
      // Mode 1: Validate all shifts have owners assigned
      const allAssigned = Object.values(reactivateFormData.shiftOwnerAssignments)
        .every(ownerId => ownerId !== null && ownerId !== "");

      if (!allAssigned) {
        setError("Please assign an owner for each shift");
        return;
      }
    } else {
      // Mode 2: Validate all shifts in array have owners
      const allAssigned = reactivateFormData.shifts.every(shift => shift.ownerId);
      if (!allAssigned) {
        setError("Please assign an owner for each shift");
        return;
      }
    }

    setError("");

    try {
      // Build payload based on mode
      const payload = {
        reactivationDate: reactivateFormData.reactivationDate,
        reason: reactivateFormData.reason,
        reactivatedBy: "admin", // TODO: Get from auth context
        keepSameOwners: reactivateFormData.keepSameOwners
      };

      if (reactivateFormData.keepSameOwners) {
        // Mode 1: Simple owner assignments
        payload.shiftOwnerAssignments = reactivateFormData.shiftOwnerAssignments;
      } else {
        // Mode 2: Full shift configurations
        payload.shifts = reactivateFormData.shifts;
      }

      const response = await fetch(
        `${API_BASE_URL}/cabs/${selectedCabForReactivation.id}/reactivate`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${localStorage.getItem("token")}`,
            "X-Tenant-ID": localStorage.getItem("tenantSchema"),
          },
          body: JSON.stringify(payload),
        }
      );

      if (response.ok) {
        const data = await response.json();
        setSuccess(`Cab ${selectedCabForReactivation.cabNumber} reactivated successfully`);
        setOpenReactivateDialog(false);
        setSelectedCabForReactivation(null);
        setShiftsForReactivation([]);

        // Force full page reload to refresh all cab and shift data
        window.location.reload();
      } else {
        const errorData = await response.json();
        setError(errorData.error || "Failed to reactivate cab");
      }
    } catch (err) {
      console.error("Error reactivating cab:", err);
      setError("Failed to reactivate cab");
    }
  };

  // Helper: Update individual shift in reactivation (new owners mode)
  const handleReactivateShiftUpdate = (index, updatedShift) => {
    setReactivateFormData(prev => ({
      ...prev,
      shifts: prev.shifts.map((shift, i) => i === index ? updatedShift : shift)
    }));
  };

  const handleLogout = () => {
    localStorage.removeItem("token");
    localStorage.removeItem("user");
    router.push("/signin");
  };

  // ===== Attribute Functions =====

  const loadAttributeTypes = async () => {
    try {
      // Load active types for dropdown in Tab 2
      const activeRes = await fetch(`${API_BASE_URL}/cab-attribute-types/active`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });
      if (activeRes.ok) {
        const data = await activeRes.json();
        setAttributeTypes(data);
      }

      // Load all types for management in Tab 3
      const allRes = await fetch(`${API_BASE_URL}/cab-attribute-types`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
          "X-Tenant-ID": localStorage.getItem("tenantSchema"),
        },
      });
      if (allRes.ok) {
